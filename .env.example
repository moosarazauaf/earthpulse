# Copy to .env (backend reads backend/.env, frontend reads frontend/.env.local).
# Never commit a filled-in copy.

# ---- Backend -------------------------------------------------------------
# Origins allowed to call the API, comma separated.
EARTHPULSE_CORS_ORIGINS=http://localhost:5173
# Largest AOI a single analysis may cover, in square kilometres.
EARTHPULSE_MAX_AOI_KM2=20000
# Upper bound on pixels read per band per scene; the engine coarsens the
# working resolution to stay under it and reports the resolution it used.
EARTHPULSE_MAX_PIXELS=1500000
# Requests per minute per client for analysis endpoints.
EARTHPULSE_RATE_LIMIT_PER_MINUTE=20
# Where the analysis store and tile cache live.
EARTHPULSE_DATA_DIR=var

# Optional Google Earth Engine backend (not required; not used by default).
# Path to a service-account key file kept outside the repository.
# EARTHPULSE_GEE_SERVICE_ACCOUNT_FILE=
# EARTHPULSE_GEE_PROJECT=

# ---- Frontend ------------------------------------------------------------
# Address of the analysis service. frontend/.env.development sets it for the
# dev server. Leave it unset in a build to get hosted mode (no backend).
VITE_API_BASE=http://localhost:8000
# Optional Cesium ion token, used only for world terrain. Ion tokens are
# public client tokens by design; restrict yours to your domain in the ion
# dashboard. Without it the globe renders on a smooth ellipsoid.
# VITE_CESIUM_ION_TOKEN=
